      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "stahl.luke@web.de",
        "ascAppId": "6474795966",
        "appleTeamId": "3X5J8LXMDM"
      }
    }
  }
}
